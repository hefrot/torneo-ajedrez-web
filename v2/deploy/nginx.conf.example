server {
    listen 443 ssl http2;
    server_name chess.hmena.com;
    # TLS directives managed by your existing certificate setup.
    location /api/ { proxy_pass http://127.0.0.1:3210; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
    location / { proxy_pass http://127.0.0.1:3210; proxy_set_header Host $host; }
}
