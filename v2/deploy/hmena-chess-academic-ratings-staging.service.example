[Unit]
Description=HMENA Chess academic rating sync (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/hmena-chess-v2-staging/v2
EnvironmentFile=/etc/hmena-chess-v2-staging.env
ExecStart=/usr/bin/node scripts/sync-academic-ratings.mjs
NoNewPrivileges=true
PrivateTmp=true
