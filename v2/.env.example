PORT=3210

# Staging scaffold can still run on SQLite. Production migration must reconcile
# historical PostgreSQL first; do not create a second source of truth blindly.
DATABASE_PATH=/var/lib/hmena-chess/league.sqlite
DATABASE_URL=
ADMIN_API_KEY=change-me
SEASON_NAME=HMENA Chess League 2026
SEASON_MAX_DAYS=10

# Audited shared WhatsApp bridge on the VPS.
# The real chess group JID stays only in the VPS environment, never in GitHub.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3010
WHATSAPP_BRIDGE_AUTH_HEADER=X-API-Key
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_GROUP_ID=

# Lichess: per-player OAuth tokens must be stored outside the repository.
LICHESS_CLIENT_ID=
LICHESS_REDIRECT_URI=https://chess.hmena.com/oauth/lichess/callback

# Chess.com asks API clients to identify themselves; use a real contact address.
CHESSCOM_USER_AGENT=HMENA-Chess-League/0.1 (contact: admin@example.com)

# Google Sheets master sync. Share the Sheet with the service account.
GOOGLE_SHEETS_ID=your-master-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=
