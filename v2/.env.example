PORT=3210
DATABASE_PATH=/var/lib/hmena-chess/league.sqlite
ADMIN_API_KEY=change-me
SEASON_NAME=HMENA Chess League 2026
SEASON_MAX_DAYS=10

# WhatsApp adapter: existing VPS bot can expose a small send-group endpoint.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3300
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_GROUP_ID=

# Lichess: per-player OAuth tokens should be stored outside the repository.
LICHESS_CLIENT_ID=
LICHESS_REDIRECT_URI=https://chess.hmena.com/oauth/lichess/callback

# Chess.com asks API clients to identify themselves; use a real contact address.
CHESSCOM_USER_AGENT=HMENA-Chess-League/0.1 (contact: admin@example.com)

# Google Sheets master sync. Share the Sheet with the service account.
GOOGLE_SHEETS_ID=your-master-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=
